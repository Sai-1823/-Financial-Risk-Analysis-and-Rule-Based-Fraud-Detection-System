# Project 21: Financial Risk Analysis and Fraud Detection Environment Config

# Database Connection (FastAPI backend)
# If DATABASE_URL is not set, the app will check MYSQL_* settings.
# If neither is configured, the application automatically uses SQLite (sqlite:///./project21.db)
# Example MySQL URI:
# DATABASE_URL=mysql+mysqlconnector://fraud_user:fraud_pass@localhost:3306/fraud_db
DATABASE_URL=sqlite:///./project21.db

# Alternative granular MySQL environment variables:
MYSQL_USER=fraud_user
MYSQL_PASSWORD=fraud_pass
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fraud_detection_db

# Server settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
